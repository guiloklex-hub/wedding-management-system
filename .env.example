# Banco de dados (SQLite/libSQL)
DATABASE_URL="file:./dev.db"

# Auth.js
NEXTAUTH_SECRET="trocar-por-segredo-aleatorio-em-producao"
# Em produção atrás de proxy/CDN (ex.: Cloudflare Tunnel), use o domínio público (ex.: https://site.exemplo.com.br)
NEXTAUTH_URL="http://localhost:3005"
# Necessário em prod atrás de proxy quando Auth.js v5 não infere o host correto
AUTH_TRUST_HOST="true"

# URL pública usada para montar links em emails/WhatsApp
# Em produção, use o domínio público (ex.: https://site.exemplo.com.br)
APP_URL="http://localhost:3005"

# Senha do admin inicial (usada pelo seed)
ADMIN_PASSWORD="admin"

# Cron job (lembretes de pagamento/tarefa)
# Gerar com: openssl rand -hex 32
CRON_SECRET=""

# SMTP — envio de email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Wedding Finance\" <noreply@example.com>"
