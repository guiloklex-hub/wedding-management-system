generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model EventSettings {
  id                 String   @id @default("singleton")
  eventDate          DateTime
  contingencyPercent Float    @default(10)
  currency           String   @default("BRL")
  coupleNames        String?
  updatedAt          DateTime @updatedAt
}

model Vendor {
  id           String       @id @default(cuid())
  name         String
  category     String
  categoryKey  String?
  status       String       @default("NEGOTIATION")
  contractLink String?
  notes        String?
  rating       Int?
  tags         String?
  indicatedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  budgetItems  BudgetItem[]
  payments     Payment[]
  contacts     VendorContact[]
  vendorNotes  VendorNote[]
  contracts    Contract[]
  attachments  Attachment[]
}

model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorNote {
  id        String   @id @default(cuid())
  vendorId  String
  body      String
  kind      String   @default("NOTE")
  createdAt DateTime @default(now())
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model Contract {
  id                 String   @id @default(cuid())
  vendorId           String
  title              String
  version            Int      @default(1)
  status             String   @default("DRAFT")
  signedAt           DateTime?
  expiresAt          DateTime?
  totalValue         Float?
  paymentTerms       String?
  cancellationPolicy String?
  includedItems      String?
  excludedItems      String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  vendor             Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attachments        Attachment[]

  @@index([vendorId])
}

model Attachment {
  id          String   @id @default(cuid())
  ownerType   String
  ownerId     String
  vendorId    String?
  contractId  String?
  kind        String   @default("OTHER")
  filename    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId])
}

model BudgetItem {
  id             String   @id @default(cuid())
  title          String
  estimatedValue Float
  actualValue    Float?
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
}

model Payment {
  id                String   @id @default(cuid())
  amount            Float
  dueDate           DateTime
  paidAt            DateTime?
  status            String   @default("PENDING")
  method            String?
  installmentNumber Int?
  totalInstallments Int?
  notes             String?
  vendorId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  vendor            Vendor   @relation(fields: [vendorId], references: [id])
}

model Asset {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  payload   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
