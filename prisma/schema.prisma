generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  phone                String?
  password             String
  role                 String    @default("ADMIN")
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  passwordUpdatedAt    DateTime?
  lastLoginAt          DateTime?
  archivedAt           DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  twoFactorUpdatedAt   DateTime?
  locale               String    @default("pt-BR")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  attachmentsUploaded  Attachment[] @relation("AttachmentUploader")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model NotificationLog {
  id          String   @id @default(cuid())
  kind        String
  channel     String
  userId      String?
  targetEmail String?
  targetPhone String?
  status      String
  errorMsg    String?
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([kind, refType, refId])
  @@index([createdAt])
  @@index([kind, status, createdAt])
}

model SecuritySettings {
  id                String   @id @default("singleton")
  require2FARoles   String   @default("[]")
  passwordMinLength Int      @default(8)
  updatedAt         DateTime @default(now()) @updatedAt
}

model EventSettings {
  id                     String    @id @default("singleton")
  eventDate              DateTime?
  contingencyPercent     Float     @default(10)
  currency               String    @default("BRL")
  coupleNames            String?
  rainPlanB              String?
  daySchedule            String?
  daySpecialNotes        String?
  onboardingCompletedAt  DateTime?
  defaultLocale          String    @default("pt-BR")
  pixKey                 String?
  pixKeyType             String?
  pixHolderName          String?
  pixCity                String?
  weddingWebsiteUrl      String?
  giftRegistryUrl        String?
  saveTheDateMessage     String?
  saveTheDateFilePath    String?
  saveTheDateFileMime    String?
  saveTheDateFileName    String?
  saveTheDateExcludeTagIds   String?
  saveTheDateExcludePadrinhos Boolean @default(false)
  updatedAt              DateTime  @updatedAt
}

model Broadcast {
  id         String               @id @default(cuid())
  kind       String
  status     String               @default("DRAFT")
  channel    String               @default("AUTO")
  total      Int                  @default(0)
  createdAt  DateTime             @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  recipients BroadcastRecipient[]
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  refType     String
  refId       String
  name        String
  memberNames String
  phone       String?
  email       String?
  locale      String?
  status      String    @default("PENDING")
  channelUsed String?
  error       String?
  sentAt      DateTime?
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
}

model Vendor {
  id           String       @id @default(cuid())
  name         String
  category     String
  categoryKey  String?
  status       String       @default("NEGOTIATION")
  contractLink String?
  notes        String?
  rating       Int?
  tags         String?
  indicatedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  budgetItems  BudgetItem[]
  payments     Payment[]
  contacts     VendorContact[]
  vendorNotes  VendorNote[]
  contracts    Contract[]
  attachments  Attachment[]
  tasks        Task[]

  @@index([status, deletedAt])
  @@index([categoryKey])
  @@index([deletedAt])
}

model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorNote {
  id        String   @id @default(cuid())
  vendorId  String
  body      String
  kind      String   @default("NOTE")
  createdAt DateTime @default(now())
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model Contract {
  id                 String   @id @default(cuid())
  vendorId           String
  title              String
  version            Int      @default(1)
  status             String   @default("DRAFT")
  signedAt           DateTime?
  expiresAt          DateTime?
  totalValue         Float?
  paymentTerms       String?
  cancellationPolicy String?
  includedItems      String?
  excludedItems      String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  vendor             Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attachments        Attachment[]

  @@index([vendorId])
  @@index([vendorId, status])
}

model Attachment {
  id           String   @id @default(cuid())
  ownerType    String
  ownerId      String
  vendorId     String?
  contractId   String?
  venueId      String?
  kind         String   @default("OTHER")
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  sha256Full   String?
  version      Int      @default(1)
  uploadedById String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  vendor       Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  venue        Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([contractId, kind])
  @@index([sha256Full])
}

model Venue {
  id               String   @id @default(cuid())
  name             String
  address          String?
  mapsUrl          String?
  capacitySeated   Int?
  capacityStanding Int?
  baseRate         Float?
  pricingNotes     String?
  restrictions     String?
  pros             String?
  cons             String?
  isShortlisted    Boolean  @default(false)
  visitedAt        DateTime?
  contactName      String?
  contactPhone     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  checklistItems   VenueChecklistItem[]
  attachments      Attachment[]
  tasks            Task[]
}

model VenueChecklistItem {
  id        String   @id @default(cuid())
  venueId   String
  label     String
  checked   Boolean  @default(false)
  value     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sortOrder])
}

model BudgetItem {
  id             String   @id @default(cuid())
  title          String
  estimatedValue Float
  actualValue    Float?
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  vendor         Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([vendorId, deletedAt])
}

model Payment {
  id                       String   @id @default(cuid())
  amount                   Float
  dueDate                  DateTime
  paidAt                   DateTime?
  status                   String   @default("PENDING")
  method                   String?
  installmentNumber        Int?
  totalInstallments        Int?
  lateFeePercent           Float?
  interestPercentPerMonth  Float?
  notes                    String?
  vendorId                 String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?

  vendor                   Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status, dueDate])
  @@index([deletedAt, status, dueDate])
}

model Asset {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  date      DateTime
  notes     String?
  goalId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  goal      SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([date])
  @@index([deletedAt])
}

model Income {
  id           String   @id @default(cuid())
  title        String
  source       String   @default("SALARY")
  amount       Float
  expectedDate DateTime?
  receivedAt   DateTime?
  status       String   @default("EXPECTED")
  frequency    String   @default("ONE_TIME")
  givenByName  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([status, expectedDate])
  @@index([deletedAt])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  targetDate   DateTime?
  notes        String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  assets       Asset[]
}

model Honeymoon {
  id          String   @id @default("singleton")
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  currency    String   @default("BRL")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       HoneymoonItem[]
}

model HoneymoonItem {
  id                 String   @id @default(cuid())
  honeymoonId        String
  kind               String   @default("ACTIVITY")
  title              String
  vendor             String?
  startAt            DateTime?
  endAt              DateTime?
  amount             Float?
  currency           String   @default("BRL")
  status             String   @default("PLANNED")
  confirmationNumber String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  honeymoon          Honeymoon @relation(fields: [honeymoonId], references: [id], onDelete: Cascade)

  @@index([honeymoonId, kind])
}

model TrousseauItem {
  id             String   @id @default(cuid())
  title          String
  room           String   @default("OTHER")
  priority       String   @default("NICE_TO_HAVE")
  status         String   @default("TO_BUY")
  estimatedPrice Float?
  actualPrice    Float?
  store          String?
  link           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([room, status])
}

model Guest {
  id                  String    @id @default(cuid())
  name                String
  phone               String?
  email               String?
  side                String?
  groupName           String?
  groupId             String?
  rsvpStatus          String    @default("INVITED")
  rsvpToken           String    @unique @default(cuid())
  rsvpTokenExpiresAt  DateTime?
  rsvpRespondedAt     DateTime?
  plusOnesAllowed     Int       @default(0)
  plusOnesConfirmed   Int       @default(0)
  isChild             Boolean   @default(false)
  isVIP               Boolean   @default(false)
  isPadrinho          Boolean   @default(false)
  age                 Int?
  dietary             String?
  language            String?
  tableNumber         String?
  tableId             String?
  city                String?
  checkedInAt         DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  gifts             Gift[]
  group             GuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  table             SeatingTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tags              GuestTagOnGuest[]

  @@index([rsvpStatus])
  @@index([deletedAt])
  @@index([groupId])
  @@index([tableId])
}

model GuestGroup {
  id                  String    @id @default(cuid())
  name                String
  rsvpToken           String    @unique @default(cuid())
  rsvpTokenExpiresAt  DateTime?
  rsvpPin             String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  guests        Guest[]

  @@index([deletedAt])
}

model GuestTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  guests    GuestTagOnGuest[]

  @@index([deletedAt])
}

model GuestTagOnGuest {
  guestId   String
  tagId     String
  createdAt DateTime @default(now())

  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tag       GuestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([guestId, tagId])
  @@index([tagId])
}

model SeatingTable {
  id          String   @id @default(cuid())
  name        String
  capacity    Int      @default(8)
  shape       String   @default("ROUND")
  x           Float    @default(0)
  y           Float    @default(0)
  sortOrder   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  guests      Guest[]

  @@index([deletedAt])
}

model Gift {
  id                String   @id @default(cuid())
  guestId           String?
  giverName         String?
  type              String   @default("CASH")
  amount            Float?
  description       String?
  status            String   @default("RECEIVED")
  receivedAt        DateTime @default(now())
  thankedAt         DateTime?
  isHoneymoonShare  Boolean  @default(false)
  pixPaidAt         DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  guest             Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([guestId])
  @@index([deletedAt])
}

model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  deadline     DateTime?
  completedAt  DateTime?
  status       String   @default("TODO")
  priority     String   @default("MEDIUM")
  responsible  String?
  vendorId     String?
  venueId      String?
  sortOrder    Int      @default(0)
  templateKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([status, deadline])
  @@index([deadline])
  @@index([vendorId])
  @@index([venueId])
  @@index([deletedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  payload   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}
