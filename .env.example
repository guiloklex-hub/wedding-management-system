# ============================================================
#  Wedding Finance — variáveis de ambiente
# ------------------------------------------------------------
#  Copie este arquivo para `.env` e ajuste os valores.
#  O `setup.sh` (Linux/macOS/WSL) e `setup.ps1` (Windows)
#  fazem isso automaticamente quando `.env` não existe.
#
#  Em produção, NUNCA versione o `.env`. Use a sua plataforma
#  de deploy (PM2, systemd, Docker, etc.) para injetar.
# ============================================================


# === BÁSICO ==================================================

# URL de conexão com o banco SQLite.
# Em dev: arquivo local. Em prod: caminho absoluto recomendado.
#   Ex.: "file:/var/lib/wedding/dev.db"
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT do NextAuth.
# Gere com:
#   Linux/Mac: openssl rand -base64 32
#   Windows:   o setup.ps1 gera automaticamente
NEXTAUTH_SECRET="trocar-por-segredo-aleatorio-em-producao"

# URL pública usada pelo NextAuth para callbacks.
# Em dev: http://localhost:3005
# Em prod: https://seudominio.com (com https!)
NEXTAUTH_URL="http://localhost:3005"

# Necessário em prod atrás de proxy/CDN (Cloudflare Tunnel,
# nginx, etc.) quando o Auth.js v5 não consegue inferir o host.
AUTH_TRUST_HOST="true"

# URL pública para montar links em emails e WhatsApp
# (links de reset de senha, RSVP, lembretes, etc.).
APP_URL="http://localhost:3005"

# Senha do usuário admin inicial. Usada apenas no `prisma db seed`.
# No primeiro login, o usuário é forçado a trocá-la.
ADMIN_PASSWORD="admin"


# === CRON (lembretes automáticos) ============================

# Bearer token que protege GET /api/cron/reminders.
# Gere com:
#   Linux/Mac: openssl rand -hex 32
#   Windows:   o setup.ps1 gera automaticamente
# Configure um cron externo (crontab/Task Scheduler) para
# bater a cada 30 minutos:
#   */30 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#                http://localhost:3005/api/cron/reminders
CRON_SECRET=""


# === EMAIL (SMTP) ============================================
#
# Opcional — também pode ser configurado pela tela
# Ajustes › Casamento depois do primeiro login.
#
# Eventos enviados por email:
#   • criação de conta
#   • reset de senha
#   • lembretes de pagamentos próximos / atrasados
#   • lembretes de tarefas próximas / atrasadas
#
# Gmail: ative verificação em 2 passos e gere uma App Password
#        em https://myaccount.google.com/apppasswords (use ela
#        no SMTP_PASS, não a sua senha normal).
# ------------------------------------------------------------

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # true para porta 465 (TLS direto)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Wedding Finance\" <noreply@example.com>"


# === WHATSAPP ================================================
#
# A integração com WhatsApp (Baileys) sobe sozinha quando o
# servidor inicia. Em caso de queda, o sistema:
#   • tenta reconectar com back-off exponencial (3s → 60s)
#   • envia e-mail para todos os admins ativos após ~1min fora
#     do ar e novamente quando a conexão volta
#
# Para desativar o autostart (útil em dev), defina como "false":
WHATSAPP_AUTOSTART="true"

# ─────────────────────────────────────────────────────────────
# Save the Date — envio em massa
# ─────────────────────────────────────────────────────────────
# Intervalo (ms) entre cada mensagem da fila de Save the Date.
# Throttle anti-bloqueio do WhatsApp. Padrão: 4000 (4s).
BROADCAST_INTERVAL_MS="4000"
