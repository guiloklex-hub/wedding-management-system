generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model EventSettings {
  id                 String   @id @default("singleton")
  eventDate          DateTime
  contingencyPercent Float    @default(10)
  currency           String   @default("BRL")
  coupleNames        String?
  updatedAt          DateTime @updatedAt
}

model Vendor {
  id           String       @id @default(cuid())
  name         String
  category     String
  categoryKey  String?
  status       String       @default("NEGOTIATION")
  contractLink String?
  notes        String?
  rating       Int?
  tags         String?
  indicatedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  budgetItems  BudgetItem[]
  payments     Payment[]
  contacts     VendorContact[]
  vendorNotes  VendorNote[]
  contracts    Contract[]
  attachments  Attachment[]
  tasks        Task[]
}

model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorNote {
  id        String   @id @default(cuid())
  vendorId  String
  body      String
  kind      String   @default("NOTE")
  createdAt DateTime @default(now())
  deletedAt DateTime?

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model Contract {
  id                 String   @id @default(cuid())
  vendorId           String
  title              String
  version            Int      @default(1)
  status             String   @default("DRAFT")
  signedAt           DateTime?
  expiresAt          DateTime?
  totalValue         Float?
  paymentTerms       String?
  cancellationPolicy String?
  includedItems      String?
  excludedItems      String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  vendor             Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attachments        Attachment[]

  @@index([vendorId])
}

model Attachment {
  id          String   @id @default(cuid())
  ownerType   String
  ownerId     String
  vendorId    String?
  contractId  String?
  venueId     String?
  kind        String   @default("OTHER")
  filename    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  venue       Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId])
}

model Venue {
  id               String   @id @default(cuid())
  name             String
  address          String?
  mapsUrl          String?
  capacitySeated   Int?
  capacityStanding Int?
  baseRate         Float?
  pricingNotes     String?
  restrictions     String?
  pros             String?
  cons             String?
  isShortlisted    Boolean  @default(false)
  visitedAt        DateTime?
  contactName      String?
  contactPhone     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  checklistItems   VenueChecklistItem[]
  attachments      Attachment[]
  tasks            Task[]
}

model VenueChecklistItem {
  id        String   @id @default(cuid())
  venueId   String
  label     String
  checked   Boolean  @default(false)
  value     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sortOrder])
}

model BudgetItem {
  id             String   @id @default(cuid())
  title          String
  estimatedValue Float
  actualValue    Float?
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
}

model Payment {
  id                String   @id @default(cuid())
  amount            Float
  dueDate           DateTime
  paidAt            DateTime?
  status            String   @default("PENDING")
  method            String?
  installmentNumber Int?
  totalInstallments Int?
  notes             String?
  vendorId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  vendor            Vendor   @relation(fields: [vendorId], references: [id])
}

model Asset {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  date      DateTime
  notes     String?
  goalId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  goal      SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([goalId])
}

model Income {
  id           String   @id @default(cuid())
  title        String
  source       String   @default("SALARY")
  amount       Float
  expectedDate DateTime?
  receivedAt   DateTime?
  status       String   @default("EXPECTED")
  frequency    String   @default("ONE_TIME")
  givenByName  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([status, expectedDate])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  targetDate   DateTime?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  assets       Asset[]
}

model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  deadline     DateTime?
  completedAt  DateTime?
  status       String   @default("TODO")
  priority     String   @default("MEDIUM")
  responsible  String?
  vendorId     String?
  venueId      String?
  sortOrder    Int      @default(0)
  templateKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([status, deadline])
  @@index([deadline])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  payload   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
